# ---- LLM (required) ---------------------------------------------------------
# Google Gemini API key. Free tier is plenty for this app.
# Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model to use. Default is Gemini Flash-Lite (fast + free-tier friendly).
GEMINI_MODEL=gemini-2.5-flash-lite

# Generation tuning
LLM_TEMPERATURE=0.4
LLM_MAX_RETRIES=1

# ---- Notion source (optional) ----------------------------------------------
# Only needed if you generate quizzes from Notion. The token lives ONLY here,
# on the backend. It is never sent to or stored in the frontend.
# Create one at: https://www.notion.so/my-integrations
NOTION_TOKEN=

# ---- HTTP / CORS ------------------------------------------------------------
# Comma-separated list of origins allowed to call this API.
# Local dev default below; add your deployed frontend URL in production.
ALLOWED_ORIGINS=http://localhost:3000

# Port the Flask server listens on.
PORT=5000

# ---- Limits (safety rails for free tier + payload size) ---------------------
MAX_QUESTIONS=20
MAX_CONTENT_CHARS=24000
